<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.UserMapper">
    <select id="SelectUserById" resultType="com.example.demo.dao.User">
        SELECT * FROM user WHERE id=#{id}
    </select>
    <select id="SelectUserByStatus" resultType="com.example.demo.dao.User">
<!--        SELECT * FROM user WHERE status=#{status} GROUP BY user.id ORDER BY user.id-->
    </select>
    <select id="SelectProductById" resultType="com.example.demo.dao.Product">
        SELECT product.* FROM orders LEFT JOIN order_item ON orders.id=order_item.order_id
        LEFT JOIN product ON product.id=order_item.product_id WHERE orders.id=#{id};
    </select>

    <insert id="InsertUser">
        INSERT INTO user(username,age,create_time,update_time) VALUES (#{username},#{age},NOW(),NOW());
    </insert>
</mapper>
